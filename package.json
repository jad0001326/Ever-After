{
  "name": "ever-after",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:planning-rls && npm run test:supplier-owner-rls && npm run test:supplier-claim-review && npm run test:data-api-grants && npm run test:supplier-outreach-migration && npm run test:production-migration-alignment",
    "test:planning-browser": "node scripts/verify-planning-hub-browser.mjs",
    "test:planning-api": "node scripts/verify-planning-workspace-api.mjs",
    "test:planning-rls": "node scripts/verify-planning-workspace-rls.mjs",
    "test:supplier-owner-rls": "node scripts/verify-supplier-owner-rls.mjs",
    "test:supplier-claim-review": "node scripts/verify-supplier-claim-review.mjs",
    "test:supplier-claim-concurrency": "node scripts/verify-supplier-claim-concurrency.mjs",
    "test:data-api-grants": "node scripts/verify-data-api-table-grants.mjs",
    "test:supplier-outreach-migration": "node scripts/verify-supplier-outreach-migration.mjs",
    "test:production-migration-alignment": "node scripts/verify-production-migration-alignment.mjs",
    "planning-api:prepare-local": "node scripts/prepare-planning-supabase-test.mjs",
    "planning-contract:check": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-planning-contracts.mts",
    "planning-contract:write": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-planning-contracts.mts --write",
    "enrichment:audit": "node scripts/run-enrichment-audit.mts --dry-run",
    "supplier:audit": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/audit-supplier-catalogue.mts --read-only",
    "enrichment:stage": "node scripts/stage-enrichment-review.mts",
    "pricing:recover": "node scripts/build-pricing-recovery.mts",
    "pricing:curate": "node scripts/build-curated-pricing.mts",
    "pricing:publication-sql": "node scripts/build-pricing-publication-sql.mts",
    "pricing:stage": "node scripts/stage-pricing-options.mts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@next/third-parties": "16.2.12",
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "clsx": "latest",
    "lucide-react": "latest",
    "next": "16.2.12",
    "pdf-parse": "2.4.5",
    "react": "latest",
    "react-dom": "latest",
    "read-excel-file": "^9.0.9",
    "sharp": "0.35.3",
    "svix": "^1.96.1",
    "tailwind-merge": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "axe-core": "4.11.4",
    "eslint": "latest",
    "eslint-config-next": "16.2.12",
    "pg": "8.23.0",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "jsdom": "latest"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "hono": "4.12.34",
    "ip-address": "10.3.1",
    "nanoid": "3.3.17",
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  }
