{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:everaft:planning-budget-resource:v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "workspaceId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "plan": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "userId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "totalBudgetPence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "currency": {
          "type": "string",
          "enum": [
            "GBP",
            "EUR",
            "USD"
          ]
        },
        "weddingDate": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 20
            },
            {
              "type": "null"
            }
          ]
        },
        "guestCount": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 10000
            },
            {
              "type": "null"
            }
          ]
        },
        "location": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        },
        "contingencyType": {
          "type": "string",
          "enum": [
            "none",
            "fixed",
            "percentage"
          ]
        },
        "contingencyValue": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "selectedVenueId": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "scenarioName": {
          "type": "string",
          "maxLength": 80
        },
        "categories": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "isCustom": {
                "type": "boolean"
              },
              "suggestedPercentage": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "targetPence": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "collapsed": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "name",
              "isCustom",
              "targetPence",
              "collapsed"
            ],
            "additionalProperties": false
          }
        },
        "items": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "categoryId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "listingId": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "listingType": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 80
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "listingUrl": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "imageUrl": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 1000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source": {
                "type": "string",
                "enum": [
                  "manual",
                  "website"
                ]
              },
              "itemName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "supplierName": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 160
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "supplierType": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "description": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 2000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "estimatedCostPence": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "confirmedCostPence": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "importedPricePence": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "importedPriceToPence": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "importedPriceType": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "fixed",
                      "starting_from",
                      "per_person",
                      "package",
                      "range",
                      "quote_required",
                      "unavailable"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "costPerPersonPence": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "guestCount": {
                "anyOf": [
                  {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 10000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "depositPaidPence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000
              },
              "totalPaidPence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000
              },
              "installments": {
                "default": [],
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "deposit",
                        "installment",
                        "final",
                        "other"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "amountPence": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 1000000000
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "paidPence": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000000
                    },
                    "dueDate": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "paidAt": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "kind",
                    "label",
                    "amountPence",
                    "paidPence",
                    "dueDate",
                    "paidAt"
                  ],
                  "additionalProperties": false
                }
              },
              "costStatus": {
                "type": "string",
                "enum": [
                  "estimated",
                  "quoted",
                  "booked",
                  "deposit_paid",
                  "partially_paid",
                  "paid",
                  "cancelled"
                ]
              },
              "paymentStatus": {
                "type": "string",
                "enum": [
                  "not_started",
                  "deposit_paid",
                  "partially_paid",
                  "paid",
                  "overpaid"
                ]
              },
              "bookingStatus": {
                "type": "string",
                "enum": [
                  "researching",
                  "shortlisted",
                  "quoted",
                  "booked",
                  "cancelled"
                ]
              },
              "availabilityStatus": {
                "default": "not_checked",
                "type": "string",
                "enum": [
                  "not_checked",
                  "enquiry_sent",
                  "available",
                  "unavailable"
                ]
              },
              "availabilityDate": {
                "default": null,
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "dueDate": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 20
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "websiteUrl": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "notes": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 4000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "createdAt": {
                "type": "string"
              },
              "updatedAt": {
                "type": "string"
              },
              "sortOrder": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "categoryId",
              "listingId",
              "listingType",
              "listingUrl",
              "imageUrl",
              "source",
              "itemName",
              "supplierName",
              "supplierType",
              "description",
              "estimatedCostPence",
              "confirmedCostPence",
              "importedPricePence",
              "importedPriceToPence",
              "importedPriceType",
              "costPerPersonPence",
              "guestCount",
              "depositPaidPence",
              "totalPaidPence",
              "installments",
              "costStatus",
              "paymentStatus",
              "bookingStatus",
              "availabilityStatus",
              "availabilityDate",
              "dueDate",
              "websiteUrl",
              "notes",
              "createdAt",
              "updatedAt",
              "sortOrder"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "userId",
        "name",
        "totalBudgetPence",
        "currency",
        "weddingDate",
        "guestCount",
        "location",
        "contingencyType",
        "contingencyValue",
        "createdAt",
        "updatedAt",
        "selectedVenueId",
        "scenarioName",
        "categories",
        "items"
      ],
      "additionalProperties": false
    },
    "versions": {
      "type": "object",
      "properties": {
        "workspaceUpdatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "budgetUpdatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "workspaceUpdatedAt",
        "budgetUpdatedAt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "workspaceId",
    "plan",
    "versions"
  ],
  "additionalProperties": false,
  "title": "EverAft Planning Budget Resource v1",
  "description": "A complete connected budget and its conflict versions."
}
