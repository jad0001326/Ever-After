{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:everaft:planning-dashboard-snapshot:v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "workspace": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "budgetPlanId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name",
        "budgetPlanId"
      ],
      "additionalProperties": false
    },
    "wedding": {
      "type": "object",
      "properties": {
        "date": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "guestCount": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "location": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "type": "string",
          "enum": [
            "GBP",
            "EUR",
            "USD"
          ]
        },
        "profileCompletionPercentage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "date",
        "guestCount",
        "location",
        "currency",
        "profileCompletionPercentage"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "totalBudgetPence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "spendableBudgetPence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "plannedPence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "committedPence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "paidPence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "remainingPence": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "outstandingCommittedPence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "uncommittedPlannedPence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "percentUsed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "missingPriceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "activeItemCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "health": {
          "type": "string",
          "enum": [
            "over",
            "close",
            "healthy"
          ]
        }
      },
      "required": [
        "totalBudgetPence",
        "spendableBudgetPence",
        "plannedPence",
        "committedPence",
        "paidPence",
        "remainingPence",
        "outstandingCommittedPence",
        "uncommittedPlannedPence",
        "percentUsed",
        "missingPriceCount",
        "activeItemCount",
        "health"
      ],
      "additionalProperties": false
    },
    "payments": {
      "type": "object",
      "properties": {
        "overdueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dueSoonCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "upcomingCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "next": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "itemId": {
                  "type": "string",
                  "minLength": 1
                },
                "itemName": {
                  "type": "string",
                  "minLength": 1
                },
                "installmentId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "dueDate": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "amountPence": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "outstandingPence": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "urgency": {
                  "type": "string",
                  "enum": [
                    "overdue",
                    "due_soon",
                    "upcoming"
                  ]
                }
              },
              "required": [
                "itemId",
                "itemName",
                "installmentId",
                "label",
                "dueDate",
                "amountPence",
                "outstandingPence",
                "urgency"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "overdueCount",
        "dueSoonCount",
        "upcomingCount",
        "next"
      ],
      "additionalProperties": false
    },
    "tasks": {
      "type": "object",
      "properties": {
        "openCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "overdueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dueTodayCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dueSoonCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "nextTaskId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "openCount",
        "overdueCount",
        "dueTodayCount",
        "dueSoonCount",
        "nextTaskId"
      ],
      "additionalProperties": false
    },
    "guests": {
      "type": "object",
      "properties": {
        "totalCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "acceptedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pendingCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "declinedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dietaryCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "seatingGuestCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "assignedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unassignedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "targetGap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "totalCount",
        "acceptedCount",
        "pendingCount",
        "declinedCount",
        "dietaryCount",
        "seatingGuestCount",
        "assignedCount",
        "unassignedCount",
        "targetGap"
      ],
      "additionalProperties": false
    },
    "recommendation": {
      "type": "object",
      "properties": {
        "stage": {
          "type": "string",
          "enum": [
            "payments",
            "venue",
            "photography",
            "suppliers",
            "guests",
            "tables",
            "tasks"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "payment"
                },
                "itemId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "itemId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "venue-search"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "photography-search"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "supplier-roadmap"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "plan-item"
                },
                "itemId": {
                  "type": "string",
                  "minLength": 1
                },
                "fallback": {
                  "type": "string",
                  "enum": [
                    "venue-search",
                    "photography-search"
                  ]
                }
              },
              "required": [
                "kind",
                "itemId",
                "fallback"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "organise"
                },
                "anchor": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "planning-tasks-title",
                        "guest-readiness-title"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "kind",
                "anchor"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "stage",
        "title",
        "reason",
        "target"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "workspace",
    "wedding",
    "budget",
    "payments",
    "tasks",
    "guests",
    "recommendation"
  ],
  "additionalProperties": false,
  "title": "EverAft Planning Dashboard Snapshot v1",
  "description": "Platform-neutral Planning Hub dashboard state for web, iOS and Android clients."
}
